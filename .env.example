# ============================================================================
# Variables de entorno de Brar (plantilla, SIN valores reales).
#
#   cp .env.example .env      -> docker compose lo lee automáticamente.
#
# El .env real NUNCA se versiona (está en .gitignore). Donde se despliegue la imagen se definen
# estas mismas variables en el panel/servidor. Para `dotnet run` usa variables de entorno o
# `dotnet user-secrets --project Brar set "NaturalJwt:Key" "..."` (mismas claves con ':').
# ============================================================================

# --- Base de datos propia de Brar ----------------------------------------------
# Producción: cadena de la BD NUEVA de Supabase (no la de Natural). Obligatoria.
# (En docker compose se arma sola con las POSTGRES_* de abajo.)
ConnectionStrings__DefaultConnection=Host=TU_HOST;Port=5432;Database=TU_BD;Username=TU_USUARIO;Password=TU_PASSWORD

# Solo docker compose (contenedor local de PostgreSQL).
POSTGRES_DB=brar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- JWT de Natural (el superadmin entra con el login de Natural) ----------------
# Debe ser EXACTAMENTE la misma clave con la que Natural firma sus tokens. Obligatoria, >= 32 caracteres.
NaturalJwt__Key=PON_AQUI_LA_MISMA_CLAVE_JWT_DE_NATURAL
# Opcionales (por defecto: Natural.Api / Natural.Client).
NaturalJwt__Issuer=Natural.Api
NaturalJwt__Audience=Natural.Client

# --- API interna de plataforma de Natural -----------------------------------------
# URL base de la API de Natural. Obligatoria.
NaturalApi__BaseUrl=https://naturalback.vip/v2/api
# Debe ser IGUAL a Plataforma__ClaveServicio configurada en Natural. Obligatoria, >= 32 caracteres.
# Genera una aleatoria, p. ej.:  openssl rand -base64 48
NaturalApi__ClaveServicio=PON_AQUI_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
# Timeout de cada llamada a Natural, en segundos (por defecto 15).
NaturalApi__TimeoutSegundos=15

# --- Despliegue detrás de un proxy ---
# Solo si el proxy deja el prefijo en la ruta (p. ej. /brar). Vacío = Brar en la raíz de su host.
# PathBase=
# true detrás de nginx para auditar la IP real (solo si Brar no es accesible directamente desde internet).
# UseForwardedHeaders=true

# --- CORS ---------------------------------------------------------------------------
# Orígenes permitidos (uno por índice). Vacío = cualquier origen.
Cors__AllowedOrigins__0=

# --- ASP.NET Core ---------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production    (docker compose usa Development por defecto)
# true = aplica las migraciones de EF al arrancar. En producción: true solo en el primer arranque.
# RunMigrationsOnStartup=true
